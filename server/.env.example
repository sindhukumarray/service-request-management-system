# Server configuration
PORT=5000

# Reverse proxy configuration (optional)
# Set TRUST_PROXY to the number of trusted proxy hops or a trusted proxy IP/CIDR.
# Example: TRUST_PROXY=1  # suitable when exactly one trusted reverse proxy (e.g., single NGINX) is in front
# WARNING: Do NOT set TRUST_PROXY to "true", "*", or an overly broad value in production —
# doing so can allow spoofed X-Forwarded-For headers and weaken IP-based protections.
# TRUST_PROXY=1

# Database connection
MONGODB_URI=mongodb://localhost:27017/service-request-db
